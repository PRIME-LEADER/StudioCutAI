# Gemini is the primary AI provider. Groq is optional and used as a fallback.
# Use your own provider keys; never put them in browser code or commit .env.local.
AI_PROVIDER=auto
AI_API_PORT=8788
GEMINI_API_KEY=
GROQ_API_KEY=
JAMENDO_CLIENT_ID=

# Supabase project configuration.
# VITE_ values are public browser configuration; protect data with the included RLS migration.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-side cloud API authentication. Never use VITE_ on secret values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Reserved for trusted backend administration only; StudioCut does not need it for normal sync.
SUPABASE_SECRET_KEY=
REQUIRE_SUPABASE_AUTH=false
# Optional absolute API URL for desktop builds. Leave empty for same-origin web deployments.
VITE_API_BASE_URL=
# Comma-separated web/Tauri origins allowed to call the API from another origin.
API_ALLOWED_ORIGINS=
# Local API binds to loopback by default. Set to 0.0.0.0 only behind a trusted production proxy.
API_HOST=127.0.0.1

# Local video generation through ComfyUI. Disabled unless a local API workflow,
# installed model, and every node/input below are configured.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_FILE=
COMFYUI_PROMPT_NODE_ID=
COMFYUI_PROMPT_INPUT=
COMFYUI_MODEL_NODE_ID=
COMFYUI_MODEL_INPUT=
COMFYUI_WIDTH_NODE_ID=
COMFYUI_WIDTH_INPUT=
COMFYUI_HEIGHT_NODE_ID=
COMFYUI_HEIGHT_INPUT=
COMFYUI_DURATION_NODE_ID=
COMFYUI_DURATION_INPUT=
COMFYUI_OUTPUT_NODE_ID=
COMFYUI_DURATION_UNIT=frames
COMFYUI_FRAMES_PER_SECOND=16
# Set this to the workflow model's minimum VRAM requirement to prevent unsupported runs.
COMFYUI_MIN_VRAM_GB=0
