{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "build": "node scripts/copy-ffmpeg-core.mjs && tsc -b && vite build",
    "build:desktop": "npm run build -- --mode desktop",
    "lint": "oxlint",
    "test": "node --test",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env.local server.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build:windows": "node --env-file-if-exists=.env.local scripts/check-desktop-config.mjs && tauri build --bundles nsis"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
